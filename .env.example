# ---- LLM ----------------------------------------------------------------
# fake  = deterministic, no network, no key. CI and cold start use this.
# openai = real calls. Only the person wiring detection quality needs this.
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ---- Slack --------------------------------------------------------------
# Socket Mode: no public URL needed. App-level token starts with xapp-,
# bot token with xoxb-.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated channel IDs the agent is allowed to observe. Empty = all
# channels it has been invited to.
SLACK_ALLOWED_CHANNELS=

# ---- Replay -------------------------------------------------------------
# The demo path, and the only one that needs neither a key nor a network.
# Both are overridden by --transcript and --speed on the command line.
REPLAY_TRANSCRIPT=fixtures/transcripts/demo-main.json
# 1 = the original pacing, 6 = six times faster, 0 = no waiting at all.
# Gaps are capped at 2.5s regardless, so a long pause never stalls a demo.
REPLAY_SPEED=4

# ---- Browser bridge (stage 2) -------------------------------------------
# Local port the Chrome extension posts captions to.
BROWSER_BRIDGE_PORT=8787
# Who the agent supports during a live meeting. Everything is routed to this
# person privately; a meeting is never broadcast into. Required by
# --adapter browser.
PRINCIPAL_ACTOR_ID=local-user

# ---- Agent behaviour ----------------------------------------------------
# Never deliver anything, just log what it would have done.
DRY_RUN=true
# Minimum confidence required to intervene at all.
POLICY_MIN_CONFIDENCE=0.62
# Minimum confidence required to post publicly in a channel (higher bar:
# a public mistake is louder than a private one).
POLICY_MIN_CONFIDENCE_PUBLIC=0.72
# Per-surface silence window after the agent speaks, in seconds.
POLICY_COOLDOWN_SECONDS=120
# How long the same signal, for the same person, counts as already handled.
POLICY_DEDUPE_SECONDS=600
# The second gate: one model call that can veto a decision the thresholds
# already allowed. The fake provider never vetoes, so this only changes
# anything with LLM_PROVIDER=openai. Turn it off to make a run deterministic.
POLICY_SECOND_OPINION=true
# How many events of context the detector looks at.
WINDOW_MAX_EVENTS=12
WINDOW_MAX_AGE_SECONDS=900
# Detection needs at least this much conversation before it says anything.
WINDOW_MIN_EVENTS=2

# ---- Meeting memory -----------------------------------------------------
# Meeting memory is local and partitioned by principal. Node >=22.13 required.
MEETING_MEMORY_DIR=meeting-memory

# ---- Observability ------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=logs/decisions.jsonl
